# Use a managed PostgreSQL database in production. SQLite is only for local development.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/edusphere?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
PORT=3000
API_PREFIX="api"
NODE_ENV="production"

# Demo seed credentials (development/staging only). Never reuse production passwords.
SEED_SUPER_ADMIN_PASSWORD="use-a-unique-password-of-at-least-12-characters"
SEED_SCHOOL_ADMIN_PASSWORD="use-a-unique-password-of-at-least-12-characters"
SEED_TEACHER_PASSWORD="use-a-unique-password-of-at-least-12-characters"
SEED_STUDENT_PASSWORD="use-a-unique-password-of-at-least-12-characters"
SEED_PARENT_PASSWORD="use-a-unique-password-of-at-least-12-characters"

# Production bootstrap: use `npm run admin:ensure` with these values instead of the demo seed.
SUPER_ADMIN_EMAIL="admin@yourdomain.com"
SUPER_ADMIN_PASSWORD="use-a-unique-password-of-at-least-12-characters"
