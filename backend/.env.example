# Use a managed PostgreSQL database in production. SQLite is only for local development.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/schoolos?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
PORT=3000
API_PREFIX="api"
NODE_ENV="production"
CORS_ORIGINS="https://your-frontend-domain.vercel.app"
FRONTEND_URL="https://your-frontend-domain.vercel.app"
ROOT_DOMAIN="schoolos.app"

# Cloudinary image storage (keep the API secret server-side)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Gmail / SMTP for OTP and transactional email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-gmail-address"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="SchoolOS <your-gmail-address>"

# Demo seed credential (development/staging only). Never reuse a production password.
SEED_PASSWORD="use-a-unique-password-of-at-least-12-characters"

# Production bootstrap: use `npm run admin:ensure` with these values instead of the demo seed.
SUPER_ADMIN_EMAIL="admin@yourdomain.com"
SUPER_ADMIN_PASSWORD="use-a-unique-password-of-at-least-12-characters"
