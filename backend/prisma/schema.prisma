generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model School {
  id             String           @id @default(uuid())
  name           String
  type           String?
  slug           String           @unique
  domain         String?          @unique
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  country        String           @default("Pakistan")
  postalCode     String?
  logoUrl        String?
  website        String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  academicYears  AcademicYear[]
  accountEntries AccountEntry[]
  announcements  Announcement[]
  attendances    Attendance[]
  auditLogs      AuditLog[]
  books          Book[]
  classes        Class[]
  events         Event[]
  exams          Exam[]
  payments       FeePayment[]
  feeStructures  FeeStructure[]
  homeworks      Homework[]
  hostels        Hostel[]
  leaveRequests  LeaveRequest[]
  notifications  Notification[]
  parents        Parent[]
  payrolls       Payroll[]
  staff          Staff[]
  students       Student[]
  subjects       Subject[]
  subscription   Subscription?
  teachers       Teacher[]
  routes         TransportRoute[]
  users          User[]
  buildings      Building[]
  onboardingPayments OnboardingPayment[]

  @@index([slug])
  @@index([deletedAt])
}

model Subscription {
  id        String   @id @default(uuid())
  schoolId  String   @unique
  plan      String   @default("STARTER")
  status    String   @default("ACTIVE")
  startDate DateTime @default(now())
  endDate   DateTime
  amount    Float    @default(0)
  currency  String   @default("PKR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id])
}

model OnboardingPayment {
  id          String    @id @default(uuid())
  schoolId    String
  plan        String
  amount      Float     @default(0)
  method      String
  reference   String?
  screenshotUrl String?
  status      String    @default("PENDING")
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([status])
}

model SupportTicket {
  id          String        @id @default(uuid())
  ticketNo    String        @unique
  schoolName  String
  schoolSlug  String
  senderName  String
  senderEmail String
  subject     String
  message     String
  category    String        @default("GENERAL")
  priority    String        @default("MEDIUM")
  status      String        @default("OPEN")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  replies     TicketReply[]
}

model TicketReply {
  id        String        @id @default(uuid())
  ticketId  String
  sender    String
  message   String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model PlatformAnnouncement {
  id        String   @id @default(uuid())
  title     String
  message   String
  target    String   @default("ALL")
  priority  String   @default("NORMAL")
  isActive  Boolean  @default(true)
  author    String   @default("Super Admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([target, isActive])
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  name                String
  role                String
  phone               String?
  avatarUrl           String?
  isActive            Boolean              @default(true)
  emailVerified       Boolean              @default(false)
  lastLoginAt         DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?
  schoolId            String?
  mustChangePassword  Boolean              @default(false)
  auditLogs           AuditLog[]
  emailVerifications  EmailVerification[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  school              School?              @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([email])
  @@index([deletedAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model PasswordResetToken {
  id        String        @id @default(uuid())
  token     String        @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerification {
  id        String   @id @default(uuid())
  otp       String
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AcademicYear {
  id          String       @id @default(uuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean      @default(false)
  schoolId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  school      School       @relation(fields: [schoolId], references: [id])
  attendances Attendance[]
  classes     Class[]
  exams       Exam[]

  @@index([schoolId])
}

model Class {
  id             String         @id @default(uuid())
  name           String
  numeric        Int?
  schoolId       String
  academicYearId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  academicYear   AcademicYear?  @relation(fields: [academicYearId], references: [id])
  school         School         @relation(fields: [schoolId], references: [id])
  subjects       ClassSubject[]
  feeStructures  FeeStructure[]
  sections       Section[]

  @@unique([name, schoolId, academicYearId])
  @@index([schoolId])
}

model Section {
  id          String       @id @default(uuid())
  name        String
  classId     String
  teacherId   String?
  capacity    Int          @default(40)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  attendances Attendance[]
  exams       Exam[]
  homeworks   Homework[]
  teacher     Teacher?     @relation("ClassTeacher", fields: [teacherId], references: [id])
  class       Class        @relation(fields: [classId], references: [id])
  students    Student[]
  timetables  Timetable[]

  @@index([classId])
}

model Subject {
  id            String         @id @default(uuid())
  name          String
  code          String?
  description   String?
  schoolId      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  classSubjects ClassSubject[]
  results       ExamResult[]
  homeworks     Homework[]
  school        School         @relation(fields: [schoolId], references: [id])
  timetables    Timetable[]

  @@index([schoolId])
}

model ClassSubject {
  id        String   @id @default(uuid())
  classId   String
  subjectId String
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])
  class     Class    @relation(fields: [classId], references: [id])

  @@unique([classId, subjectId])
}

model Student {
  id                    String               @id @default(uuid())
  admissionNo           String               @unique
  name                  String
  dateOfBirth           DateTime?
  gender                String?
  bloodGroup            String?
  religion              String?
  nationality           String?
  phone                 String?
  email                 String?
  address               String?
  avatarUrl             String?
  isActive              Boolean              @default(true)
  isAlumni              Boolean              @default(false)
  status                String               @default("ACTIVE")
  admissionDate         DateTime             @default(now())
  session               String?
  bFormNumber           String?
  currentAddress        String?
  permanentAddress      String?
  emergencyContact      String?
  previousSchool        String?
  previousClass        String?
  leavingCertificateUrl String?
  admissionType         String               @default("NEW")
  previousAcademicRecord String?
  medicalNotes          String?
  specialRequirements   String?
  transportRequired     Boolean              @default(false)
  hostelRequired        Boolean              @default(false)
  remarks               String?
  leavingDate           DateTime?
  rollNo                String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?
  schoolId              String
  sectionId             String?
  attendances           Attendance[]
  bookIssues            BookIssue[]
  documents             Document[]
  examResults           ExamResult[]
  feePayments           FeePayment[]
  homeworkSubmissions   HomeworkSubmission[]
  hostelAllocation      HostelAllocation?
  section               Section?             @relation(fields: [sectionId], references: [id])
  school                School               @relation(fields: [schoolId], references: [id])
  parents               StudentParent[]
  transportAssignment   TransportAssignment?

  @@index([schoolId])
  @@index([sectionId])
  @@index([admissionNo])
  @@index([deletedAt])
}

model Teacher {
  id             String         @id @default(uuid())
  employeeNo     String         @unique
  name           String
  email          String         @unique
  phone          String?
  gender         String?
  dateOfBirth    DateTime?
  bloodGroup     String?
  qualification  String?
  experience     Int?
  joiningDate    DateTime       @default(now())
  salary         Float?
  avatarUrl      String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  schoolId       String
  attendances    Attendance[]
  classSubjects  ClassSubject[]
  homeworks      Homework[]
  leaveRequests  LeaveRequest[]
  payrolls       Payroll[]
  sectionTeacher Section[]      @relation("ClassTeacher")
  school         School         @relation(fields: [schoolId], references: [id])
  timetables     Timetable[]

  @@index([schoolId])
  @@index([deletedAt])
}

model Parent {
  id               String          @id @default(uuid())
  name             String
  email            String?
  phone            String
  occupation       String?
  address          String?
  avatarUrl        String?
  relation         String          @default("Parent")
  fatherName       String?
  fatherMobile1    String?
  fatherMobile2    String?
  fatherWhatsapp   String?
  fatherCnic       String?
  fatherOccupation String?
  motherName       String?
  motherMobile     String?
  motherCnic       String?
  motherOccupation String?
  guardianName     String?
  guardianRelation String?
  guardianMobile   String?
  addressCountry   String?
  addressProvince  String?
  addressCity      String?
  addressLine      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?
  schoolId         String
  userId           String?         @unique
  school           School          @relation(fields: [schoolId], references: [id])
  students         StudentParent[]

  @@index([schoolId])
}

model StudentParent {
  id        String  @id @default(uuid())
  studentId String
  parentId  String
  isPrimary Boolean @default(false)
  parent    Parent  @relation(fields: [parentId], references: [id])
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, parentId])
}

model Staff {
  id            String         @id @default(uuid())
  employeeNo    String         @unique
  name          String
  email         String         @unique
  phone         String?
  designation   String
  department    String?
  salary        Float?
  joiningDate   DateTime       @default(now())
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  schoolId      String
  leaveRequests LeaveRequest[]
  payrolls      Payroll[]
  school        School         @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

model Attendance {
  id             String        @id @default(uuid())
  date           DateTime
  status         String
  remarks        String?
  createdAt      DateTime      @default(now())
  schoolId       String
  academicYearId String?
  sectionId      String?
  studentId      String?
  teacherId      String?
  teacher        Teacher?      @relation(fields: [teacherId], references: [id])
  student        Student?      @relation(fields: [studentId], references: [id])
  section        Section?      @relation(fields: [sectionId], references: [id])
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  school         School        @relation(fields: [schoolId], references: [id])

  @@index([schoolId, date])
  @@index([studentId, date])
  @@index([teacherId, date])
}

model Timetable {
  id        String  @id @default(uuid())
  dayOfWeek Int
  startTime String
  endTime   String
  room      String?
  sectionId String
  subjectId String
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])
  section   Section @relation(fields: [sectionId], references: [id])

  @@index([sectionId, dayOfWeek])
}

model Exam {
  id             String        @id @default(uuid())
  name           String
  type           String
  startDate      DateTime
  endDate        DateTime
  totalMarks     Float         @default(100)
  passingMarks   Float         @default(33)
  description    String?
  isPublished    Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  schoolId       String
  academicYearId String?
  sectionId      String?
  section        Section?      @relation(fields: [sectionId], references: [id])
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  school         School        @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}
